{
  "name": "databastion",
  "version": "0.3.0",
  "private": true,
  "description": "Release tooling for the DataBastion repository (the console has its own package.json in console/).",
  "license": "Apache-2.0",
  "scripts": {
    "release": "release-it",
    "release:dry": "release-it --dry-run --ci && node scripts/changelog-release.mjs preview \"$(release-it --ci --release-version --no-github.release)\"",
    "bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "12.0.2",
    "release-it": "21.1.0"
  },
  "overrides": {
    "basic-ftp": "6.2.1",
    "undici": "7.29.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
