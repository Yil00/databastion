# Settings of the console deployment (docker-compose.example.yml). Copy to `.env` in the same
# directory: `docker compose` reads it. Step by step: deploy/README.md.

# Console image, REQUIRED with its digest: copy the console line of the release's
# image-digests.txt, after verifying SHA256SUMS with cosign (deploy/README.md). Never `latest`.
# Compose refuses to start with this placeholder.
DATABASTION_CONSOLE_IMAGE=ghcr.io/yil00/databastion-console:<version>@sha256:<digest from image-digests.txt>

# DNS name of the console (the agents and your browser use https://<name>).
DATABASTION_DOMAIN=databastion.example.com

# Bundled HTTPS proxy (`--profile proxy`): your e-mail address for a Let's Encrypt certificate
# (the name must reach this host on ports 80 and 443), or `internal` for a certificate from
# Caddy's own CA (agents pin its root certificate).
DATABASTION_TLS=internal

# Username of the first administrator (bootstrap-admin).
DATABASTION_ADMIN_USERNAME=admin
