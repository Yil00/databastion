{
  "name": "@databastion/console",
  "version": "0.1.0",
  "private": true,
  "description": "DataBastion console (control plane): Next.js web app + pg-boss worker.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-build-wakeups.mjs",
    "check:build": "node scripts/check-build-wakeups.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "protocol:generate": "tsx scripts/protocol/generate.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "worker": "tsx src/worker/index.ts",
    "admin:bootstrap": "tsx src/cli/bootstrap-admin.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "next": "16.3.6",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
