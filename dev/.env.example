# DataBastion dev environment. Copy to dev/.env (`make dev` does it if missing).
# DEV-ONLY credentials: never reuse them anywhere else. Values must not contain quotes.
COMPOSE_PROJECT_NAME=databastion-dev

# Read-only account `databastion` in every engine (docs/05-security.md).
DATABASTION_DB_PASSWORD=dev-only-databastion-readonly

# Administrator accounts (seeding and manual inspection only; the agent never uses them).
POSTGRES_ADMIN_PASSWORD=dev-only-postgres-admin
MARIADB_ROOT_PASSWORD=dev-only-mariadb-root
MYSQL_ROOT_PASSWORD=dev-only-mysql-root
PERCONA_ROOT_PASSWORD=dev-only-percona-root
MONGO_ROOT_PASSWORD=dev-only-mongo-root
LDAP_ADMIN_PASSWORD=dev-only-ldap-admin
GRAFANA_ADMIN_PASSWORD=dev-only-grafana-admin

# Keycloak (opt-in, `make dev-keycloak`; ADR-0038 OIDC test realm). Administrator of the master realm,
# secret of the `databastion-console` client (give the same value to the console as
# DATABASTION_OIDC_CLIENT_SECRET), and the password of every seeded realm user.
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin
KEYCLOAK_CONSOLE_CLIENT_SECRET=dev-only-keycloak-console-client-secret
KEYCLOAK_DEV_USER_PASSWORD=dev-only-keycloak-user

# Apereo CAS (opt-in, `make dev-cas`; target of the CAS connector, ADR-0041). Password of every
# static CAS user (dev/cas/config/cas.properties) and of the PostgreSQL role `cas` that owns the
# JPA ticket registry (database `cas`).
CAS_DEV_USER_PASSWORD=dev-only-cas-user
CAS_DB_PASSWORD=dev-only-cas-db

# SQL Server (opt-in, `make dev-sqlserver`; ADR-0051). `sa` (seeding and inspection only) and the agent
# login `databastion`: SQL Server's password policy needs three character classes and refuses a
# password containing the login name, so the agent login has its own value.
SQLSERVER_SA_PASSWORD=dev-only-SqlServer-sa-1
SQLSERVER_DATABASTION_PASSWORD=dev-only-Agent-ReadOnly-1

# Valkey / Redis (opt-in, `make dev-redis`; ADR-0052). The agent's ACL users `databastion` and
# `databastion_scoped` use DATABASTION_DB_PASSWORD; `admin` seeds the keyspace.
REDIS_ADMIN_PASSWORD=dev-only-redis-admin

# Firebird (opt-in, `make dev-firebird`; ADR-0060). SYSDBA (seeding and inspection only, never the
# agent) and the agent's account DATABASTION_AGENT (also the password of the refused account
# AGENT_SYSDBA_MAPPED). No host port: the server listens on its own namespace's loopback only.
FIREBIRD_SYSDBA_PASSWORD=dev-only-firebird-sysdba
FIREBIRD_DATABASTION_PASSWORD=dev-only-firebird-agent

# MongoDB Community profiler (level 1). 0 = every operation is "slow" (dev visibility);
# raise it (e.g. 100) to reproduce the production trade-off described in docs/08.
MONGO_SLOWMS=0

# Host ports (all bound to 127.0.0.1). Change them if they clash with local services.
POSTGRES_PORT=5432
MARIADB_PORT=3307
MYSQL_PORT=3306
PERCONA_PORT=3308
MONGO_PORT=27017
PSMDB_PORT=27019
LDAP_PORT=1389
LDAPS_PORT=1636
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
PROMETHEUS_PORT=9090
# The console /metrics bearer token is NOT set here: `make dev` generates dev/.state/metrics_token
# (0600, git-ignored). Start the host console with DATABASTION_METRICS_TOKEN_FILE pointing to it.
GRAFANA_PORT=3001
# The Keycloak issuer URL contains this port: http://127.0.0.1:${KEYCLOAK_PORT}/realms/databastion.
KEYCLOAK_PORT=8180
# The CAS server name contains this port: http://127.0.0.1:${CAS_PORT}/cas.
CAS_PORT=8280
SQLSERVER_PORT=1433
VALKEY_PORT=6379
REDIS_PORT=6389
