# MariaDB audit prerequisites (docs/08-engine-capabilities.md): server_audit plugin, file output.
[mariadb]
plugin_load_add = server_audit
server_audit = FORCE_PLUS_PERMANENT
server_audit_logging = ON
server_audit_events = CONNECT,QUERY_DML,TABLE
server_audit_output_type = file
server_audit_file_path = /var/log/databastion/server_audit.log
server_audit_file_rotate_size = 10485760
server_audit_file_rotations = 5
# The image's healthcheck user polls every few seconds: keep it out of the audit trail.
server_audit_excl_users = healthcheck
# performance_schema: statement history with ROWS_SENT (the Audit fallback when the server_audit log
# is not configured). The history consumers depend on events_statements_current, which MariaDB
# leaves off by default: without it, events_statements_history_long stays empty.
performance_schema = ON
performance-schema-consumer-events-statements-current = ON
performance-schema-consumer-events-statements-history = ON
performance-schema-consumer-events-statements-history-long = ON
# DEV-ONLY TLS material created by tls-entrypoint.sh before the server starts (throwaway CA,
# certificate for 127.0.0.1 / localhost / mariadb), so that the agent can use its default
# `tls: verify_full` with a pinned CA. MariaDB 10.11 aborts if one of these files is missing. Kept
# outside the datadir, which the server would list as a database `#mysql50#databastion-tls`.
ssl_ca = /var/lib/databastion-tls/ca.pem
ssl_cert = /var/lib/databastion-tls/server-cert.pem
ssl_key = /var/lib/databastion-tls/server-key.pem
