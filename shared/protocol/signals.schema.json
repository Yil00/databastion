{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://databastion.invalid/protocol/v1/signals.schema.json",
  "title": "Signal registry",
  "description": "signals.json: the access-event signal ids (`Signal`) that a conforming agent may emit, with their meaning and the engines whose connector emits them. Append-only: an id is never removed, renamed or given another meaning. Ids are sorted ascending (checked by scripts/signal-registry.mjs).",
  "type": "object",
  "minProperties": 1,
  "maxProperties": 256,
  "propertyNames": { "$ref": "schemas.json#/$defs/Signal" },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["description", "engines"],
    "properties": {
      "description": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Co}\\p{Zl}\\p{Zp}]+$"
      },
      "engines": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "uniqueItems": true,
        "items": { "$ref": "schemas.json#/$defs/Engine" }
      }
    }
  }
}
