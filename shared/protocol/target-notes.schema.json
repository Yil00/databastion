{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://databastion.invalid/protocol/v1/target-notes.schema.json",
  "title": "Target-note registry",
  "description": "target-notes.json: the `TargetNote` codes (`TargetNoteCode`) a conforming agent may send, with their meaning and the engines whose connector sends them. Append-only: a code is never removed, renamed or given another meaning. Codes are sorted ascending (checked by scripts/id-registry.mjs).",
  "type": "object",
  "minProperties": 1,
  "maxProperties": 256,
  "propertyNames": {
    "$ref": "schemas.json#/$defs/TargetNoteCode"
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "description",
      "engines"
    ],
    "properties": {
      "description": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Co}\\p{Zl}\\p{Zp}]+$"
      },
      "engines": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "uniqueItems": true,
        "items": {
          "$ref": "schemas.json#/$defs/Engine"
        }
      }
    }
  }
}
