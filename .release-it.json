{
  "$schema": "https://unpkg.com/release-it@17/schema/release-it.json",
  "github": {
    "release": true,
    "draft": true,
    "releaseName": "${version}",
    "tokenRef": "GITHUB_TOKEN"
  },
  "git": {
    "commit": true,
    "commitMessage": "chore(release): ${version}",
    "commitArgs": [
      "-s"
    ],
    "requireCleanWorkingDir": true,
    "requireBranch": "main",
    "tag": true,
    "tagName": "${version}",
    "tagAnnotation": "DataBastion ${version}",
    "push": true,
    "addUntrackedFiles": false
  },
  "npm": false,
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "header": "# Changelog",
      "preset": {
        "name": "conventionalcommits",
        "types": [
          {
            "type": "feat",
            "section": "✨ Fonctionnalités"
          },
          {
            "type": "fix",
            "section": "🐛 Corrections"
          },
          {
            "type": "perf",
            "section": "⚡️ Performances"
          },
          {
            "type": "security",
            "section": "🔒 Sécurité"
          },
          {
            "type": "revert",
            "section": "⏪️ Retours arrière"
          },
          {
            "type": "docs",
            "section": "📝 Documentation",
            "hidden": true
          },
          {
            "type": "refactor",
            "section": "♻️ Refactoring",
            "hidden": true
          },
          {
            "type": "test",
            "section": "✅ Tests",
            "hidden": true
          },
          {
            "type": "ci",
            "section": "👷 CI",
            "hidden": true
          },
          {
            "type": "chore",
            "section": "🔧 Maintenance",
            "hidden": true
          }
        ]
      }
    }
  },
  "hooks": {
    "after:bump": "node scripts/bump-version.mjs ${version}"
  }
}
